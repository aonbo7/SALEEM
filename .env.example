# ============================================================================
# SALEEM — Cloud Auto-Updater Configuration Template (.env.example)
# Copy this file to `.env` before running `scripts/build-release.ps1` or `scripts/publish-update.ps1`
# ============================================================================

# 1. Your Supabase Project URL
SALEEM_SUPABASE_PROJECT_URL=https://YOUR_PROJECT_REF.supabase.co

# 2. Read-only Pooler Connection URI (embedded at build time for client update checks)
SALEEM_SUPABASE_POOLER_URI=host=YOUR_REGION.pooler.supabase.com port=5432 user=saleem_readonly.YOUR_PROJECT_REF password=YOUR_READONLY_PASSWORD dbname=postgres connect_timeout=10

# 3. Publisher Script Settings (used only by scripts/publish-update.ps1)
SUPABASE_POOLER_HOST=YOUR_REGION.pooler.supabase.com
SUPABASE_ADMIN_USER=postgres.YOUR_PROJECT_REF
# Set SUPABASE_DB_PASSWORD in your terminal session when publishing an update:
# $env:SUPABASE_DB_PASSWORD = "YOUR_ADMIN_DB_PASSWORD"
